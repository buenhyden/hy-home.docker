# opensearch_dashboards.yml for the OpenSearch LAB (labs/opensearch-cluster.yml).
# The image maps OPENSEARCH_* variables to config only when its own entrypoint
# starts Dashboards, and then as command-line options; secrets stay in the
# environment and are referenced here, so none reaches argv.
server.host: 0.0.0.0
server.ssl.enabled: false
opensearch.hosts:
  - https://opensearch-node1:9200
  - https://opensearch-node2:9200
  - https://opensearch-node3:9200
opensearch.username: kibanaserver
opensearch.password: ${OPENSEARCH_PASSWORD}
opensearch.ssl.verificationMode: certificate
opensearch.ssl.certificateAuthorities:
  - /usr/share/opensearch-dashboards/config/certs/rootCA.pem
opensearch.requestHeadersAllowlist: [securitytenant, Authorization]
opensearch_security.auth.type: basicauth
opensearch_security.cookie.password: ${OPENSEARCH_SECURITY_COOKIE_PASSWORD}
