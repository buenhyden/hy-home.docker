# Documentary public inputs for labs/supabase.yml.
# Copy required keys into the single ignored labs/.env used by lab.py.
# Never create labs/supabase/.env and never place credentials in this file.

# Required isolated LAB path and host group.
LAB_DATA_DIR=""
LAB_SECRETS_GID="1000"

# LAB controller budgets and lease. Empty CPU/memory budgets refuse execution.
LAB_HOST_BUDGET_CPUS=""
LAB_HOST_BUDGET_MEMORY_MIB=""
LAB_MAX_CONCURRENT="1"
LAB_MAX_LEASE_MINUTES="1440"
LAB_READY_TIMEOUT_SECONDS="600"

# Supabase public listener and operator inputs.
LAB_SUPABASE_KONG_HTTP_HOST_PORT="8000"
LAB_SUPABASE_KONG_HTTPS_HOST_PORT="8443"
LAB_SUPABASE_ANALYTICS_HOST_PORT="4000"
LAB_SUPABASE_POSTGRES_HOST_PORT="5432"
LAB_SUPABASE_POOLER_PROXY_PORT_TRANSACTION_HOST_PORT="6543"
LAB_SUPABASE_DASHBOARD_USERNAME="supabase_admin"
LAB_SUPABASE_DOCKER_SOCKET_LOCATION="/var/run/docker.sock"
