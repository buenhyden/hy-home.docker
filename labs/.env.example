# Standalone LAB Compose inputs. No credential values belong here.
# Each LAB runs as a separate Compose project; select exactly one -f labs/<name>.yml.
# Required paths must be isolated and verified before any runtime action.
LAB_DATA_DIR=""
LAB_SECRET_DIR="../secrets/labs"
LAB_KAFKA_CLUSTER_ID=""
LAB_OPENSEARCH_CERT_DIR=""
LAB_HOST_BIND_IP="127.0.0.1"
# scripts/operations/lab.py: declared-limit budget for running containers plus
# the selected LAB, concurrent LAB count and longest lease. Empty budget refuses.
LAB_HOST_BUDGET_CPUS=""
LAB_HOST_BUDGET_MEMORY_MIB=""
LAB_MAX_CONCURRENT="1"
LAB_MAX_LEASE_MINUTES="1440"
# Shared defaults required for standalone LAB rendering; they do not join HOME networks.
LAB_PG_DEFAULT_DB="postgres"

# PostgreSQL HA LAB fixture and loopback-only host ports.
LAB_PG_SUPERUSER_USERNAME="postgres"
LAB_PG_REPLICATION_USERNAME="replicator"
LAB_PG_EXPORTER_USERNAME="exporter"
LAB_PG_FIXTURE_DB="app_db"
LAB_PG_FIXTURE_USERNAME="app_user"
LAB_PG_WRITE_HOST_PORT="35432"
LAB_PG_READ_HOST_PORT="35433"
LAB_PG_HAPROXY_STATS_HOST_PORT="37000"

# NoSQL LAB-only identities and listener ports.
LAB_COUCHDB_USERNAME="couchdb_admin"
LAB_MONGODB_ROOT_USERNAME="mongo_admin"
LAB_MONGO_EXPRESS_USERNAME="mongo_express_admin"
LAB_COUCHDB_HOST_PORT="35984"
LAB_MONGO_EXPRESS_HOST_PORT="38081"
LAB_PG_ETCD_PEER_PORT=2380
LAB_PG_ETCD_CLIENT_PORT=2379

# Loopback-only Valkey LAB node host ports.
LAB_VALKEY0_HOST_PORT="17379"
LAB_VALKEY1_HOST_PORT="17380"
LAB_VALKEY2_HOST_PORT="17381"
LAB_VALKEY3_HOST_PORT="17382"
LAB_VALKEY4_HOST_PORT="17383"
LAB_VALKEY5_HOST_PORT="17384"


# Optional LAB-only network names and internal service ports.
LAB_PG_CORE_NETWORK_NAME="hy-home-lab-pg-core"
LAB_PG_EDGE_NETWORK_NAME="hy-home-lab-pg-edge"
LAB_PG_OBS_NETWORK_NAME="hy-home-lab-pg-obs"
LAB_VALKEY_CORE_NETWORK_NAME="hy-home-lab-valkey-core"
LAB_VALKEY_OBS_NETWORK_NAME="hy-home-lab-valkey-obs"
LAB_VALKEY_EXPORTER_PORT="9121"
LAB_CASSANDRA_CORE_NETWORK_NAME="hy-home-lab-cassandra-core"
LAB_COUCHDB_CORE_NETWORK_NAME="hy-home-lab-couchdb-core"
LAB_COUCHDB_EDGE_NETWORK_NAME="hy-home-lab-couchdb-edge"
LAB_MONGODB_CORE_NETWORK_NAME="hy-home-lab-mongodb-core"
LAB_MONGODB_EDGE_NETWORK_NAME="hy-home-lab-mongodb-edge"
LAB_OPENSEARCH_CLUSTER_NAME="hyhome-lab-opensearch"

# Locust LAB-only bounded headless run. Paths must be approved and isolated.
LAB_LOCUST_SCENARIO_DIR=""
LAB_LOCUST_RESULT_DIR=""
LAB_LOCUST_NETWORK_NAME="hy-home-lab-locust"
LAB_LOCUST_EXPECT_WORKERS="2"
LAB_LOCUST_EXPECT_WORKERS_MAX_WAIT="60"
LAB_LOCUST_USERS="10"
LAB_LOCUST_SPAWN_RATE="1"
LAB_LOCUST_RUN_TIME="30s"
LAB_LOCUST_STOP_TIMEOUT="5"
LAB_LOCUST_EXIT_CODE_ON_ERROR="1"
