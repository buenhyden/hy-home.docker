  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-storybook": "^10.6.0",
    "playwright": "^1.63.0",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.2",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "eslint-plugin-import": {
