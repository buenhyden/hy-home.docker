{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "npm run build:ui",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project storybook",
    "coverage": "vitest run --project storybook --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run build:ui && storybook build && node --experimental-strip-types mcp/stamp.ts && npm run test:artifacts",
    "build:ui": "npm run build --workspace @hy-home/storybook-ui",
    "test:artifacts": "node --experimental-strip-types --test tests/artifacts.test.mjs tests/mcp.test.mjs",
    "mcp:docs": "node --experimental-strip-types mcp/server.ts"
  },
  "dependencies": {
    "@hy-home/storybook-ui": "file:packages/ui",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.4.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-onboarding": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/mcp": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-storybook": "10.6.1",
    "playwright": "^1.64.0",
    "storybook": "10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "workspaces": [
    "packages/*"
  ]
}
