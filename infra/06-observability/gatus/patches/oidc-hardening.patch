+		want            bool
+	}{
+		{name: "empty allowlist preserves upstream allow-all", tokenSubject: "subject-a", want: true},
+		{name: "exact subject", allowedSubjects: []string{"subject-a"}, tokenSubject: "subject-a", want: true},
+		{name: "case change rejected", allowedSubjects: []string{"Subject-A"}, tokenSubject: "subject-a"},
+		{name: "different subject rejected", allowedSubjects: []string{"subject-b"}, tokenSubject: "subject-a"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if got := isSubjectAllowed(test.allowedSubjects, test.tokenSubject); got != test.want {
+				t.Fatalf("expected %t, got %t", test.want, got)
+			}
+		})
 	}
 }
 
