+func TestOIDCConfig_loginHandlerUsesSecureCookiesAndPKCE(t *testing.T) {
+	c := &OIDCConfig{oauth2Config: oauth2.Config{
+		ClientID:    "client-id",
+		RedirectURL: "https://status.example.com/authorization-code/callback",
+		Endpoint:    oauth2.Endpoint{AuthURL: "https://sso.example.com/authorize"},
+	}}
+	app := fiber.New()
+	app.Get("/oidc/login", c.loginHandler)
+	response, err := app.Test(httptest.NewRequest(http.MethodGet, "/oidc/login", http.NoBody))
+	if err != nil {
+		t.Fatal(err)
+	}
+	cookies := response.Cookies()
+	if len(cookies) != 3 {
+		t.Fatalf("expected 3 OIDC cookies, got %d", len(cookies))
+	}
+	for _, cookie := range cookies {
+		if !cookie.Secure || !cookie.HttpOnly || cookie.SameSite != http.SameSiteLaxMode {
+			t.Fatalf("cookie %s is not Secure, HttpOnly, SameSite=Lax: %#v", cookie.Name, cookie)
+		}
+	}
+	location, err := url.Parse(response.Header.Get("Location"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if location.Query().Get("code_challenge_method") != "S256" || len(location.Query().Get("code_challenge")) == 0 {
+		t.Fatalf("authorization URL does not enforce S256 PKCE: %s", location.String())
+	}
+}
