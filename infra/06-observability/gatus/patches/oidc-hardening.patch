+func isSubjectAllowed(allowedSubjects []string, tokenSubject string) bool {
+	if len(allowedSubjects) == 0 {
+		return true
+	}
+	for _, allowedSubject := range allowedSubjects {
+		if allowedSubject == tokenSubject {
+			return true
 		}
 	}
