+func TestOIDCConfig_validateOIDCCookie(t *testing.T) {
+	for _, test := range []struct {
+		name, cookieName, cookieValue, expected, label, wantError string
+	}{
+		{name: "missing state", cookieName: cookieNameState, expected: "state", label: "state", wantError: "state not found"},
+		{name: "state mismatch", cookieName: cookieNameState, cookieValue: "state-a", expected: "state-b", label: "state", wantError: "state did not match"},
+		{name: "missing nonce", cookieName: cookieNameNonce, expected: "nonce", label: "nonce", wantError: "nonce not found"},
+		{name: "nonce mismatch", cookieName: cookieNameNonce, cookieValue: "nonce-a", expected: "nonce-b", label: "nonce", wantError: "nonce did not match"},
+		{name: "nonce match", cookieName: cookieNameNonce, cookieValue: "nonce", expected: "nonce", label: "nonce"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			request := httptest.NewRequest(http.MethodGet, "/", http.NoBody)
+			if len(test.cookieValue) > 0 {
+				request.AddCookie(&http.Cookie{Name: test.cookieName, Value: test.cookieValue})
+			}
+			err := validateOIDCCookie(request, test.cookieName, test.expected, test.label)
+			if test.wantError == "" && err != nil {
+				t.Fatal(err)
+			}
+			if test.wantError != "" && (err == nil || err.Error() != test.wantError) {
+				t.Fatalf("expected %q, got %v", test.wantError, err)
+			}
+		})
+	}
+}
