+func TestOIDCConfig_callbackRejectsMissingPKCEVerifier(t *testing.T) {
+	c := &OIDCConfig{}
+	request := httptest.NewRequest(http.MethodGet, "/authorization-code/callback?state=fake-state", http.NoBody)
+	request.AddCookie(&http.Cookie{Name: cookieNameState, Value: "fake-state"})
+	response := httptest.NewRecorder()
+
+	c.callbackHandler(response, request)
+
+	if response.Code != http.StatusBadRequest || !strings.Contains(response.Body.String(), "pkce verifier not found") {
+		t.Fatalf("expected missing PKCE verifier rejection, got %d: %s", response.Code, response.Body.String())
+	}
+	cleared := response.Result().Cookies()
+	if len(cleared) != 3 {
+		t.Fatalf("expected 3 one-time cookies to be cleared, got %d", len(cleared))
+	}
+	for _, cookie := range cleared {
+		if cookie.MaxAge != -1 || !cookie.Secure || !cookie.HttpOnly || cookie.SameSite != http.SameSiteLaxMode {
+			t.Fatalf("OIDC cookie %s was not securely cleared: %#v", cookie.Name, cookie)
+		}
+	}
+}
