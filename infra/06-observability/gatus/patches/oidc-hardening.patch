+func TestConfigHandler_HidesAnnouncementsBeforeOIDCAuthentication(t *testing.T) {
+	securityConfig := &security.Config{OIDC: &security.OIDCConfig{}}
+	handler := ConfigHandler{
+		securityConfig: securityConfig,
+		config: &config.Config{Announcements: []*announcement.Announcement{
+			{Message: "internal maintenance detail"},
+		}},
+	}
+	app := fiber.New()
+	app.Get("/api/v1/config", handler.GetConfig)
+	if err := securityConfig.ApplySecurityMiddleware(app); err != nil {
+		t.Fatal(err)
+	}
+
+	response, err := app.Test(httptest.NewRequest("GET", "/api/v1/config", http.NoBody))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(response.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(body) != `{"announcements":[],"authenticated":false,"oidc":true}` {
+		t.Fatalf("unauthenticated OIDC bootstrap leaked announcements: %s", body)
+	}
+}
