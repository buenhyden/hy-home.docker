-	http.Redirect(w, r, "/?error=access_denied", http.StatusFound)
+	return false
+}
+
+func validateOIDCCookie(r *http.Request, cookieName, expectedValue, label string) error {
+	cookie, err := r.Cookie(cookieName)
+	if err != nil || len(cookie.Value) == 0 {
+		return fmt.Errorf("%s not found", label)
+	}
+	if subtle.ConstantTimeCompare([]byte(cookie.Value), []byte(expectedValue)) != 1 {
+		return fmt.Errorf("%s did not match", label)
+	}
+	return nil
+}
+
+func clearOIDCCookies(w http.ResponseWriter) {
+	for _, name := range []string{cookieNameState, cookieNameNonce, cookieNamePKCEVerifier} {
+		http.SetCookie(w, &http.Cookie{
+			Name:     name,
+			Path:     "/",
+			MaxAge:   -1,
+			Expires:  time.Unix(1, 0),
+			SameSite: http.SameSiteLaxMode,
+			HttpOnly: true,
+			Secure:   true,
+		})
+	}
 }
 
