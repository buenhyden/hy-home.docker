            "value": "tempo"
          },
          {
            "selected": false,
            "text": "alloy",
            "value": "alloy"
          },
          {
            "selected": false,
            "text": "pyroscope",
            "value": "pyroscope"
          },
          {
            "selected": true,
            "text": "grafana",
            "value": "grafana"
          },
          {
            "selected": false,
            "text": "node-exporter",
            "value": "node-exporter"
          },
          {
