{
  "id": null,
  "uid": "hyhome-pyroscope",
  "title": "Pyroscope",
  "editable": false,
  "schemaVersion": 41,
  "tags": [
    "hy-home",
    "local"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU by service",
      "description": "Total CPU time sampled per step, from Alloy's pprof scrape.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "Pyroscope"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ns"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "Pyroscope"
          },
          "queryType": "metrics",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_name=~\".+\"}",
          "groupBy": [
            "service_name"
          ]
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "In-use memory by service",
      "description": "Go heap in use, from Alloy's pprof scrape.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "Pyroscope"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "Pyroscope"
          },
          "queryType": "metrics",
          "profileTypeId": "memory:inuse_space:bytes:space:bytes",
          "labelSelector": "{service_name=~\".+\"}",
          "groupBy": [
            "service_name"
          ]
        }
      ],
      "id": 2
    },
    {
      "type": "flamegraph",
      "title": "CPU flamegraph: $service",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "Pyroscope"
      },
      "description": "Pick the service in the Service variable; Drilldown > Profiles gives the same data with diffing.",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "Pyroscope"
          },
          "queryType": "profile",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_name=\"$service\"}",
          "groupBy": []
        }
      ],
      "id": 3
    },
    {
      "type": "flamegraph",
      "title": "In-use memory flamegraph: $service",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "Pyroscope"
      },
      "description": "Pick the service in the Service variable; Drilldown > Profiles gives the same data with diffing.",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "Pyroscope"
          },
          "queryType": "profile",
          "profileTypeId": "memory:inuse_space:bytes:space:bytes",
          "labelSelector": "{service_name=\"$service\"}",
          "groupBy": []
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Goroutines by service",
      "description": "A steady climb in one service is a goroutine leak.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "Pyroscope"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "Pyroscope"
          },
          "queryType": "metrics",
          "profileTypeId": "goroutine:goroutine:count:goroutine:count",
          "labelSelector": "{service_name=~\".+\"}",
          "groupBy": [
            "service_name"
          ]
        }
      ],
      "id": 5
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests by route",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (route) (rate(pyroscope_request_duration_seconds_count{job=\"pyroscope\"}[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p99 latency by route",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(pyroscope_request_duration_seconds_bucket{job=\"pyroscope\"}[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Object store operations",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (operation) (rate(objstore_bucket_operations_total{job=\"pyroscope\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Object store failures",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (operation) (rate(objstore_bucket_operation_failures_total{job=\"pyroscope\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "hide": 0,
        "query": "prometheus,alertmanager,loki,tempo,alloy,pyroscope,grafana,node-exporter,mng-pg-exporter,dev-pg-exporter,kafka-exporter,registry,seaweedfs-s3",
        "current": {
          "selected": false,
          "text": "grafana",
          "value": "grafana"
        },
        "options": [
          {
            "selected": false,
