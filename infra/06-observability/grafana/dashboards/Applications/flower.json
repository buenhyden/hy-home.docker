{
  "id": null,
  "uid": "hyhome-flower",
  "title": "Celery (Flower)",
  "editable": false,
  "schemaVersion": 41,
  "tags": [
    "hy-home",
    "local"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Workers online",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(flower_worker_online{job=\"flower\"})",
          "legendFormat": "online"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Executing tasks by worker",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (worker) (flower_worker_number_of_currently_executing_tasks{job=\"flower\"})",
          "legendFormat": "{{worker}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Task events by type",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (type) (rate(flower_events_total{job=\"flower\"}[$__rate_interval]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Task runtime p95 by task",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, task) (rate(flower_task_runtime_seconds_bucket{job=\"flower\"}[$__rate_interval])))",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Prefetch time by task",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "max by (task) (flower_task_prefetch_time_seconds{job=\"flower\"})",
          "legendFormat": "{{task}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Prefetched tasks by worker",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (worker) (flower_worker_prefetched_tasks{job=\"flower\"})",
          "legendFormat": "{{worker}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "description": "Local dashboard: no external dashboard matches flower. Provisioned by hy-home (SPEC-0193)."
}
