{
  "id": null,
  "uid": "hyhome-hermes-research",
  "title": "Hermes Research Reports",
  "editable": false,
  "schemaVersion": 41,
  "tags": [
    "hy-home",
    "local"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Time since last success",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "time() - max by (job_kind) (hermes_research_last_success_timestamp_seconds)",
          "legendFormat": "{{job_kind}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Last outcome age by job kind",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "time() - max by (job_kind, outcome) (hermes_research_last_outcome_timestamp_seconds)",
          "legendFormat": "{{job_kind}} {{outcome}}",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "BLOCKED results by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (job_kind, blocked_reason) (increase(hermes_research_blocked_total[1d]))",
          "legendFormat": "{{job_kind}} {{blocked_reason}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Last report size",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "max by (job_kind) (hermes_research_last_report_bytes)",
          "legendFormat": "{{job_kind}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "description": "Local dashboard: no external dashboard matches the Hermes plugin textfile metrics (hermes_research.prom via node-exporter). Provisioned by hy-home (SPEC-0265)."
}
