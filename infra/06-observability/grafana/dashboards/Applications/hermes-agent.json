{
  "annotations": {
    "list": []
  },
  "description": "Local dashboard: Hermes agent runtime from the hermes-otel plugin (sessions, cost, tools, TTFT, tokens) over the authenticated Alloy OTLP path; Hermes Research Reports stay in hyhome-hermes-research.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "description": "Agents the Hermes gateway reports as running right now (hermes_gateway_active_agents, built-in gateway health export).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "max(hermes_gateway_active_agents{service_name=\"hermes-gateway\"}) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cumulative cost (USD)",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "description": "USD cost Hermes priced per API call (actual or estimated) over the selected time range. Subscription models Hermes does not price emit no cost series, so the panel shows $0.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(increase({__name__=~\"hermes_cost_usage(_USD)?_total\",service_name=\"hermes-agent\"}[$__range])) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "Loop exit reasons",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "description": "Turn exit reasons (hermes.turn.exit_reason) from hermes-otel log events over the selected range, grouped by cause with the parenthesized detail removed. Needs hermes-otel structured events (logs.events.enabled: true).",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum by (exit_reason) (count_over_time({service_name=\"hermes-agent\"} | json exit_reason=\"attributes[\\\"hermes.turn.exit_reason\\\"]\" | exit_reason != \"\" | label_format exit_reason=`{{ regexReplaceAll \"\\\\(.*$\" .exit_reason \"\" }}` [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{exit_reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Input/output token throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "description": "Tokens per second by token type (input, output, cache, reasoning).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (token_type) (rate(hermes_token_usage_total{service_name=\"hermes-agent\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tool execution latency (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "description": "95th percentile tool execution time per tool (gen_ai.execute_tool.duration).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_tool_name) (rate(gen_ai_execute_tool_duration_seconds_bucket{service_name=\"hermes-agent\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{gen_ai_tool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "heatmap",
      "title": "Time to first token (TTFT)",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "description": "Distribution of seconds from a streaming API call's start (retries included) to its first chunk (hermes.api.time_to_first_chunk).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (le) (increase(hermes_api_time_to_first_chunk_seconds_bucket{service_name=\"hermes-agent\"}[$__interval]))",
          "refId": "A",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        },
        "legend": {
          "show": true
        }
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Hermes logs (OTLP)",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{service_name=~\"hermes-(agent|gateway)\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Hermes traces (OTLP)",
      "datasource": {
        "type": "tempo",
        "uid": "Tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "Tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"hermes-(agent|gateway)\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": [
    "hy-home",
    "local",
    "hermes"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "",
  "title": "Hermes Agent",
  "uid": "hyhome-hermes-agent",
  "version": 1
}
