logging {
  level  = "info"
  format = "logfmt"
}

/*****************************************************************
 * 1. LOGGING PIPELINE (Loki)
 *****************************************************************/
discovery.docker "linux" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs_relabel" {
  targets = discovery.docker.linux.targets

  rule {
    source_labels = ["__meta_docker_container_label_observability_logs"]
    regex         = "(?i)false|off|0"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["service_name", "container_name"]
    separator     = ";"
    regex         = ";(.*)"
    target_label  = "service_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    target_label = "env"
    replacement  = "dev"
  }

  rule {
    target_label = "scope"
    replacement  = "app"
  }

  // Keep this project's containers. `loki.source.docker` deduplicates
  // targets by container ID, so a container on several networks or with
  // several ports is still read once (SPEC-0180 S05 phase 2; the earlier
  // `project_net|infra_net` filter dropped segmented services instead).
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "hy-home-infra"
    action        = "keep"
  }

  rule {
    source_labels = ["service_name"]
    regex         = "prometheus|loki|tempo|grafana|alloy|cadvisor|alertmanager|pushgateway|traefik"
    target_label  = "scope"
    replacement   = "infra"
  }
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_logs_relabel.output
  forward_to = [loki.write.local_loki.receiver]
}

loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

/*****************************************************************
 * 2. METRICS PIPELINE (Prometheus)
 *****************************************************************/
// Prometheus scrapes Alloy's own /metrics as job "alloy". A self
// remote-write here sent the same series a second time as job
// "integrations/self", so it was removed (SPEC-0193).

// Only stable ownership labels and bounded k6 attributes survive; request
// names, URLs, user IDs and other producer attributes are dropped. The Rate
// `condition`, response class and producer instance must survive here,
// before delta-to-cumulative, or distinct streams would merge (SPEC-0214).
otelcol.processor.transform "quality_metrics" {
  error_mode = "ignore"

  metric_statements {
    context = "resource"
    statements = [
      `keep_keys(attributes, ["project.id", "deployment.environment.name", "service.name", "service.instance.id"])`,
    ]
  }

  metric_statements {
    context = "datapoint"
    statements = [
      `set(attributes["project_id"], resource.attributes["project.id"])`,
      `set(attributes["environment"], resource.attributes["deployment.environment.name"])`,
      `set(attributes["service_name"], resource.attributes["service.name"])`,
      `keep_keys(attributes, ["project_id", "environment", "service_name", "condition", "expected_response", "method", "status", "scenario"])`,
    ]
  }

  output {
    metrics = [otelcol.processor.deltatocumulative.quality_metrics.input]
  }
}

// Prometheus drops delta sums and histograms. This bounded experimental
// processor converts them after the label identity has been constrained.
otelcol.processor.deltatocumulative "quality_metrics" {
  max_stale   = "5m"
  max_streams = 10000

  output {
    metrics = [otelcol.processor.batch.quality_metrics.input]
  }
}

otelcol.processor.batch "quality_metrics" {
  timeout             = "1s"
  send_batch_size     = 512
  send_batch_max_size = 1024

  output {
    metrics = [otelcol.exporter.prometheus.quality_metrics.input]
  }
}

otelcol.exporter.prometheus "quality_metrics" {
  include_scope_info   = false
  include_scope_labels = false
  include_target_info  = false
  forward_to           = [prometheus.relabel.quality_metrics.receiver]
}

prometheus.relabel "quality_metrics" {
  max_cache_size = 2048
  forward_to     = [prometheus.remote_write.local_prometheus.receiver]

  rule {
    action        = "keep"
    source_labels = ["project_id", "environment", "service_name"]
    separator     = ";"
    regex         = "[^;]+;[^;]+;[^;]+"
  }

  rule {
    action = "labelkeep"
    regex  = "__name__|project_id|environment|service_name|instance|condition|expected_response|method|status|scenario|le|quantile"
  }
}

prometheus.remote_write "local_prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"

    queue_config {
      capacity             = 5000
      max_shards           = 2
      max_samples_per_send = 500
      batch_send_deadline  = "5s"
      sample_age_limit     = "5m"
    }
  }
}

// OTLP application metrics use a separate, authenticated path (SPEC-0214).
// The quality executor alone holds the token; it sets the project and
// environment resource attributes from a validated run manifest. This
// receiver is not published to the host.
local.file "quality_otlp_token" {
  filename  = "/run/secrets/quality_otlp_token"
  is_secret = true
}

otelcol.auth.bearer "quality" {
  token = local.file.quality_otlp_token.content
}

otelcol.receiver.otlp "quality" {
  http {
    endpoint = "0.0.0.0:4319"
    auth     = otelcol.auth.bearer.quality.handler
  }

  output {
    metrics = [otelcol.processor.transform.quality_metrics.input]
  }
}

/*****************************************************************
 * 3. TRACING PIPELINE (Tempo)
 *****************************************************************/
// OTLP trace 수신(4317 gRPC, 4318 HTTP). hy-home.k8s의 Istio가
// 192.168.0.13:4317로 보낸다. Compose가 두 port를 host에 공개한다.
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  // Metrics arrive only through the authenticated quality receiver.
  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

/*****************************************************************
 * 4. PROFILING PIPELINE (Pyroscope)
 *****************************************************************/
// Pull Go pprof from the services that serve /debug/pprof (SPEC-0193). No
// eBPF: nothing here needs host PID or privileges. service_name matches the
// Loki label and the Tempo service.name so the Drilldown links resolve.
pyroscope.scrape "go_services" {
  targets = [
    {"__address__" = "prometheus:9090", "service_name" = "prometheus"},
    {"__address__" = "alertmanager:9093", "service_name" = "alertmanager"},
    {"__address__" = "loki:3100", "service_name" = "loki"},
    {"__address__" = "tempo:3200", "service_name" = "tempo"},
    {"__address__" = "alloy:12345", "service_name" = "alloy"},
    {"__address__" = "pyroscope:4040", "service_name" = "pyroscope"},
    {"__address__" = "grafana:6060", "service_name" = "grafana"},
    {"__address__" = "node-exporter:9100", "service_name" = "node-exporter"},
    {"__address__" = "mng-pg-exporter:9187", "service_name" = "mng-pg-exporter"},
    {"__address__" = "registry:5001", "service_name" = "registry"},
  ]
  scrape_interval = "30s"
  forward_to      = [pyroscope.write.local_pyroscope.receiver]
}

// SeaweedFS answers /debug/pprof/block and /mutex only after the scrape
// times out (checked 2026-09-30), so those two profiles are off for it.
pyroscope.scrape "seaweedfs" {
  targets = [
    {"__address__" = "seaweedfs-s3:9327", "service_name" = "seaweedfs-s3"},
  ]
  scrape_interval = "30s"
  forward_to      = [pyroscope.write.local_pyroscope.receiver]

  profiling_config {
    profile.block {
      enabled = false
    }
    profile.mutex {
      enabled = false
    }
  }
}

pyroscope.write "local_pyroscope" {
  endpoint {
    url = "http://pyroscope:4040"
  }

  external_labels = {
    env     = "dev",
    cluster = "hy-home",
  }
}
