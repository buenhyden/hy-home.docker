        }
      },
      "id": "claim",
      "name": "Claim",
      "onError": "continueErrorOutput",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryBatching": "independently"
        },
        "query": "SELECT id,run_id,source,row_count,lease_token, to_char(lease_until AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.MS\"Z\"') AS lease_until FROM ops_flow.claim_notification();"
      },
      "position": [
        240,
        0
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "valid-claim",
      "name": "Valid Claim",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "valid-claim",
              "leftValue": "={{ ((rows) => {\n  if (!Array.isArray(rows) || rows.length !== 1) return false;\n  const r = rows[0];\n  if (!r || typeof r !== 'object' || Array.isArray(r)) return false;\n  const keys = ['id','run_id','source','row_count','lease_token','lease_until'];\n  if (Object.keys(r).length !== keys.length || !keys.every(k => Object.hasOwn(r,k))) return false;\n  const full = (pattern, value) => typeof value === 'string' && new RegExp('^(?:'+pattern+')(?![\\\\s\\\\S])').test(value);\n  const id = typeof r.id === 'number' ? Number.isSafeInteger(r.id) && r.id > 0 :\n    full('[1-9][0-9]{0,18}',r.id) && BigInt(r.id) <= 9223372036854775807n;\n  return id && full('[0-9a-f]{64}',r.run_id) &&\n    ['hy-home.docker','hy-home.k8s','Project-Template','blog-data'].includes(r.source) &&\n    Number.isSafeInteger(r.row_count) && r.row_count >= 1 && r.row_count <= 5000 &&\n    full('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}',r.lease_token) &&\n    full('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\\\.[0-9]{3}Z',r.lease_until) &&\n    Number.isFinite(Date.parse(r.lease_until)) && new Date(r.lease_until).toISOString() === r.lease_until;\n})($input.all().map(i => i.json)) }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          }
        },
        "options": {}
      },
      "position": [
        450,
        0
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
