    "/v1/candidates": {
      "get": {
        "operationId": "listCandidates",
        "description": "UTC collected date; kind/status filters; stable increasing row cursor; default 50/max 100. Quarantined bodies are restricted. No raw source endpoint.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Candidate page",
            "content": {
              "application/json": {
