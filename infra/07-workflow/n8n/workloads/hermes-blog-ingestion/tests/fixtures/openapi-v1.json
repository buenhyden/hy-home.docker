            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./responses-v1.schema.json#/definitions/error"
                }
              }
            }
          },
          "409": {
            "description": "409; stable error code, no source body or internal details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./responses-v1.schema.json#/definitions/error"
                }
              }
            }
          },
          "413": {
            "description": "413; stable error code, no source body or internal details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./responses-v1.schema.json#/definitions/error"
                }
              }
