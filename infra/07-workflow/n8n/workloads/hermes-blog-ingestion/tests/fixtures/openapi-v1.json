              "application/json": {
                "schema": {
                  "$ref": "./responses-v1.schema.json#/definitions/error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "enum": ["news", "devops", "business_idea", "infrastructure"]
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "enum": ["pending", "quarantined", "prepared", "captured", "failed", "conflict"]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ]
      }
    },
    "/v1/candidates/{id}/capture": {
      "post": {
        "operationId": "captureCandidate",
        "description": "Requires capture credential AND operator-managed exact candidate/hash allowlist; always rechecks approval on retry. Request cannot provide a path. 201 completed install, 200 previously completed; later user edits/deletion never cause regeneration.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Historical completed capture",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./responses-v1.schema.json#/definitions/capture"
                }
              }
            }
          },
          "201": {
            "description": "New or recovered capture completed",
            "content": {
              "application/json": {
                "schema": {
