{
  "openapi": "3.1.0",
  "info": {
    "title": "Blog-data Headless Ingestion",
    "version": "1.0.0",
    "description": "Blog-data owns this contract. No Obsidian, project MCP, Git or PR data transport."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "Local default; deploy only behind approved TLS/network ACL"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Producer-bound credentials. ingest/read and capture/read credentials are separate; raw tokens are never in configuration."
      }
    }
  },
  "paths": {
    "/v1/ingestions": {
      "post": {
        "operationId": "createIngestion",
        "description": "Durably commit source and multiple Items. 201 new, 200 identical replay, 409 crossed identity or changed content. Needs ingest scope.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Existing durable receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./responses-v1.schema.json#/definitions/receipt"
                }
              }
            }
          },
          "201": {
            "description": "Committed new report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./responses-v1.schema.json#/definitions/receipt"
                }
              }
            }
          },
          "400": {
            "description": "400; stable error code, no source body or internal details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./responses-v1.schema.json#/definitions/error"
                }
              }
            }
          },
          "401": {
            "description": "401; stable error code, no source body or internal details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./responses-v1.schema.json#/definitions/error"
                }
              }
            }
          },
          "403": {
