# Runs the queue attester once; the timer fires it. Install with
# `install.py --role attester` and point /opt/hermes-attester/current at the
# printed release (/opt/hermes-attester/releases/<commit>); install.py creates
# no `current` link. /etc/hermes-attester/ is owned by hermes-attester, 0700,
# and its two secret files are hermes-attester 0600: the auth-header reader
# refuses a parent directory the account does not own. StateDirectory creates
# and owns the two writable paths.
[Unit]
Description=Hermes attester: attest queued Blog-data reports
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes-attester
Group=hermes-attester
ExecStart=/opt/hermes-attester/current/venv/bin/python -I -m publisher.cli attest-queue --gateway https://blog-export.hy.home.arpa --auth-header-file /etc/hermes-attester/auth-header --signing-key /etc/hermes-attester/signing-key --key-id hermes-attester-1 --state-dir /var/lib/hermes-attester/state --evidence-dir /var/lib/hermes-attester/evidence
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StateDirectory=hermes-attester/state hermes-attester/evidence
StateDirectoryMode=0700
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
UMask=0077
