# Runs the queue attester once; the timer fires it. The operator points
# /opt/hermes-publisher/current at an installed release
# (/opt/hermes-publisher/releases/<commit>); install.py itself creates no
# `current` link. Secrets under /etc/hermes-attester/ are owned by
# hermes-attester with mode 0600 (or root:hermes-attester 0640) and read-only
# here; StateDirectory creates and owns the two writable paths.
[Unit]
Description=Hermes attester: attest queued Blog-data reports
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes-attester
Group=hermes-attester
ExecStart=/opt/hermes-publisher/current/venv/bin/python -I -m publisher.cli attest-queue --gateway https://blog-export.hy.home.arpa --auth-header-file /etc/hermes-attester/auth-header --signing-key /etc/hermes-attester/signing-key --key-id hermes-attester-1 --state-dir /var/lib/hermes-attester/state --evidence-dir /var/lib/hermes-attester/evidence
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StateDirectory=hermes-attester/state hermes-attester/evidence
StateDirectoryMode=0700
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
UMask=0077
