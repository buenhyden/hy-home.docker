// Per-run metrics ingress for one isolated k6 attempt (SPEC-0214).
// k6 reaches only this relay on the internal quality network; the relay alone
// holds the HOME Alloy bearer token and forwards to its unpublished receiver.
// metrics_relay.py starts it with the run identity in its environment. Every
// resource attribute a producer sends is replaced by that identity, so a
// scenario that posts its own OTLP cannot claim another project or run.
otelcol.receiver.otlp "k6" {
  http {
    endpoint              = "0.0.0.0:4318"
    max_request_body_size = "4MiB"
  }

  output {
    metrics = [otelcol.processor.filter.k6_names.input]
  }
}

// The executor sets K6_OTEL_METRIC_PREFIX=k6_, so every k6 metric, custom
// ones included, carries it (Rate metrics as `k6_<name>.total`). Other
// names are dropped; this bounds what a scenario can add by posting OTLP
// itself to k6-shaped names.
otelcol.processor.filter "k6_names" {
  error_mode = "propagate"

  metrics {
    metric = [
      `not IsMatch(name, "^k6_[a-zA-Z0-9_.]{1,128}$")`,
    ]
  }

  output {
    metrics = [otelcol.processor.transform.run_identity.input]
  }
}

// A missing variable yields an empty value, which HOME Alloy drops.
otelcol.processor.transform "run_identity" {
  error_mode = "propagate"

  metric_statements {
    context    = "resource"
    statements = [
      `delete_matching_keys(resource.attributes, ".*")`,
      "set(resource.attributes[\"project.id\"], \"" + sys.env("HYHOME_QUALITY_PROJECT_ID") + "\")",
      "set(resource.attributes[\"deployment.environment.name\"], \"" + sys.env("HYHOME_QUALITY_ENVIRONMENT") + "\")",
      "set(resource.attributes[\"service.instance.id\"], \"" + sys.env("HYHOME_QUALITY_INSTANCE") + "\")",
      `set(resource.attributes["service.name"], "k6")`,
    ]
  }

  output {
    metrics = [otelcol.exporter.otlphttp.home_alloy.input]
  }
}

local.file "quality_otlp_token" {
  filename  = "/run/secrets/quality_otlp_token"
  is_secret = true
}

otelcol.auth.bearer "home_alloy" {
  token = local.file.quality_otlp_token.content
}

otelcol.exporter.otlphttp "home_alloy" {
  client {
    endpoint = "http://alloy:4319"
    auth     = otelcol.auth.bearer.home_alloy.handler

    tls {
      insecure = true
    }
  }
}
