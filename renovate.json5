{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended"
  ],

  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions",
    "custom.regex",
    "pip_requirements",
    "npm"
  ],

  "docker-compose": {
    "managerFilePatterns": [
      "/^infra\\/.+\\/(?:docker-)?compose[^/]*\\.ya?ml$/"
    ]
  },

  "pip_requirements": {
    "description": "Adds image-local requirements.txt files under infra/; managerFilePatterns extends Renovate's default requirements pattern, so the scripts/ and tests/ requirements stay with Renovate as well",
    "managerFilePatterns": [
      "/^infra\\/.+\\/requirements\\.txt$/"
    ]
  },

  "npm": {
    "description": "Only the Storybook project (root and workspaces, lock at projects/storybook/nextjs/package-lock.json) and the OpsflowSmtp n8n node belong to Renovate npm; labs/** stays ignored",
    "managerFilePatterns": [
      "/^projects\\/storybook\\/nextjs\\/(?:packages\\/[^/]+\\/)?package\\.json$/",
      "/^infra\\/07-workflow\\/n8n\\/workloads\\/manifest-outbox-notifier\\/nodes\\/OpsflowSmtp\\/package\\.json$/"
    ]
  },

  "ignorePaths": [
    "docs/98.archive/**",
    "**/fixtures/**",
    "labs/**",
    "infra/**/compose.window-*.override.yml"
  ],

  "timezone": "Asia/Seoul",

  "schedule": [
    "* 0-5 * * 1"
  ],

  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",

  "dependencyDashboard": true,

  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,

  "semanticCommits": "enabled",
  "commitMessageLowerCase": "never",

  "separateMajorMinor": true,
  "vulnerabilityAlerts": {
    "groupName": null,
    "automerge": false
  },

  "postUpgradeTasks": {
    "commands": [
      "bash scripts/operations/sync-tech-stack-versions.sh --write",
      "bash scripts/operations/sync-update-ledger.sh --write"
    ],
    "fileFilters": [
      "infra/tech-stack.versions.json",
      "infra/09-platform-ops/security-updates/update-ledger.json",
      "infra/09-platform-ops/security-updates/build-inputs.json"
    ],
    "executionMode": "branch"
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "OpenTofu inline Dockerfile images",

      "managerFilePatterns": [
        "/^infra\\/09-platform-ops\\/opentofu\\/docker-compose\\.yml$/"
      ],

      "matchStrings": [
        "FROM\\s+(?<depName>ghcr\\.io/opentofu/opentofu):(?<currentValue>[^\\s]+)\\s+AS\\s+tofu",
        "FROM\\s+(?<depName>alpine):(?<currentValue>[^\\s]+)"
      ],

      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],

  "packageRules": [
    {
      "description": "The HOME GPU is a GTX 1060 (Pascal, compute 6.1), which CUDA 13 no longer supports; hold the base image on 12.x.",
      "matchPackageNames": ["nvidia/cuda"],
      "allowedVersions": "/^12\\./"
    },
    {
      "description": "open-notebook supports SurrealDB 2.x only (upstream pins surrealdb/surrealdb:v2; v3 support is open in lfnovo/open-notebook#378), and 3.x cannot read 2.x data without an export migration; hold the image on v2.x.",
      "matchPackageNames": ["surrealdb/surrealdb"],
      "allowedVersions": "/^v2\\./"
    },
    {
      "description": "인프라 주요 버전 변경은 Dashboard 승인 후 제안",
      "matchManagers": [
        "docker-compose",
        "dockerfile",
        "custom.regex"
      ],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Never automerge infrastructure images",
      "matchManagers": [
        "docker-compose",
        "dockerfile",
        "custom.regex"
      ],
      "automerge": false
    },
    {
      "description": "n8n core, runner, build args and local image tags require one manual compatibility update",
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchPackageNames": ["n8nio/n8n", "n8nio/runners"],
      "enabled": false
    },

    {
      "description": "Image-local Python pins: major updates need Dashboard approval; never automerge",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Never automerge image-local Python pins",
      "matchManagers": [
        "pip_requirements"
      ],
      "automerge": false
    },

    {
      "description": "npm: major updates need Dashboard approval; never automerge",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Never automerge npm packages",
      "matchManagers": ["npm"],
      "automerge": false
    },
    {
      "description": "Storybook: group minor and patch updates",
      "matchManagers": ["npm"],
      "matchFileNames": ["projects/storybook/nextjs/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "storybook-nextjs-minor-patch"
    },
    {
      "description": "Storybook: typescript-eslint (via eslint-config-next) rejects TypeScript 7; the 7.0.2 bump broke the frontend lint twice. Lift once typescript-eslint supports it (typescript-eslint/typescript-eslint#10940)",
      "matchManagers": ["npm"],
      "matchFileNames": ["projects/storybook/nextjs/**"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    },
    {
      "description": "OpsflowSmtp n8n-workflow must equal what the n8n image bundles, so it changes manually together with n8n",
      "matchManagers": ["npm"],
      "matchPackageNames": ["n8n-workflow"],
      "enabled": false
    },

    {
      "description": "Group observability patch and minor updates",
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ],
      "matchFileNames": [
        "infra/06-observability/**"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "observability container images"
    },
    {
      "description": "Group non-major image updates of the stateless tiers: every image update rewrites the shared SEC01 ledger, so separate PRs conflict after each merge. Data (04) and messaging (05) tiers stay one PR per image for data-format review; Airflow (constraints bundle), Keycloak (minor releases migrate its database schema on start) and the n8n sandbox keep their own PRs",
      "matchManagers": ["docker-compose", "dockerfile", "custom.regex"],
      "matchFileNames": [
        "infra/01-gateway/**",
        "infra/02-auth/**",
        "infra/03-security/**",
        "infra/07-workflow/**",
        "infra/08-ai/**",
        "infra/09-platform-ops/**",
        "infra/11-quality/**",
        "infra/13-experience/**"
      ],
      "matchPackageNames": ["!apache/airflow", "!quay.io/keycloak/keycloak", "!n8nio/**"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "stateless tier container images"
    },
    {
      "description": "Pin every container image to its digest: the SEC01 ledger refuses tag-only targets (#856, #866), so a tag-only pin can never be updated through CI",
      "matchManagers": ["docker-compose", "dockerfile", "custom.regex"],
      "pinDigests": true
    },
    {
      "description": "Batch digest-only refreshes into one PR",
      "matchManagers": ["docker-compose", "dockerfile", "custom.regex"],
      "matchUpdateTypes": ["digest"],
      "groupName": "container image digests"
    },
    {
      "description": "One PR adds all missing digest pins",
      "matchManagers": ["docker-compose", "dockerfile", "custom.regex"],
      "matchUpdateTypes": ["pinDigest"],
      "groupName": "container image digest pins"
    },

    {
      "description": "CI toolchain versions in setup-step inputs (python-version, uv version and checksum, node-version) are pinned together with the workflow contract tests, gate evidence and the uv-generated lock, so they change in one manual PR",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "enabled": false
    },
    {
      "description": "Group GitHub Actions patch and minor updates",
      "matchUpdateTypes": ["patch", "minor"],
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "semanticCommitType": "ci"
    },

    {
      "description": "Pact Broker tags carry the image version then the broker version; order by the image version and let the broker suffix change",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "pactfoundation/pact-broker"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-pactbroker\\d+\\.\\d+\\.\\d+$"
    },

    {
      "description": "Ignore locally built images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^hy\\//",
        "/^hyhome\\//",
        "/^hy-home\\//"
      ],
      "enabled": false
    }
  ]
}
