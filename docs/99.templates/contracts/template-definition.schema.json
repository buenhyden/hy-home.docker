{
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [
          "Release",
          "release",
          "operations/release",
          "operations:release"
        ]
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "responsibility": {
      "type": "string",
      "minLength": 1
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "vocabulary_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "applicability": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "data_type": {
            "type": "string",
            "minLength": 1
          },
          "requiredness": {
            "enum": [
              "required",
              "conditional",
              "optional",
              "forbidden"
            ]
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "writer": {
            "type": "string",
            "minLength": 1
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "meaning",
          "data_type",
          "requiredness",
          "condition",
          "writer",
          "consumers"
        ],
        "additionalProperties": false
      }
    },
    "headings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1
                },
                "data_type": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "key",
                "meaning",
                "data_type",
                "required"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "minimum_rows": {
            "type": "integer",
            "minimum": 0
          },
          "row_identity": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "section",
          "columns",
          "minimum_rows",
          "row_identity"
        ],
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "lifecycle": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "consumer_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "validation": {
      "type": "object",
      "properties": {
        "positive": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "negative": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "regression": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "positive",
        "negative",
        "regression"
      ],
      "additionalProperties": false
    },
    "migration": {
      "type": "object",
      "properties": {
        "meaning_map": {
          "type": "string",
          "minLength": 1
        },
        "retained_history": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "meaning_map",
        "retained_history",
        "rollback"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "delta": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "expiry_or_review": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "condition",
          "owner",
          "delta",
          "validation",
          "expiry_or_review"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "template_id",
    "contract_version",
    "role",
    "purpose",
    "responsibility",
    "non_goals",
    "policy_refs",
    "vocabulary_refs",
    "applicability",
    "metadata",
    "headings",
    "tables",
    "relationships",
    "lifecycle",
    "language",
    "consumer_paths",
    "validation",
    "migration",
    "extensions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TemplateDefinition — 프로젝트 공통 구현 입력 계약 v14.5",
  "$comment": "기존 제품 Registry 구조를 교체하는 파일이 아니다. 역할 의미를 실제 Registry에 매핑한다. 원격 경로 검증과 의미 심사는 별도다.",
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            2,
            3
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "requiredness": {
          "enum": [
            "required",
            "conditional",
            "optional"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "required_content": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "prohibited_content": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "empty_policy": {
          "enum": [
            "explain_none_or_not_applicable",
            "omit_when_condition_false",
            "forbidden"
          ]
        },
        "validation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      },
      "required": [
        "section_id",
        "level",
        "parent_id",
        "title",
        "order",
        "requiredness",
        "condition",
        "content",
        "required_content",
        "prohibited_content",
        "empty_policy",
        "validation_ids",
        "children"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "const": 2
              }
            }
          },
          "then": {
            "properties": {
              "parent_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "parent_id": {
                "type": "string",
                "minLength": 1
              },
              "children": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
