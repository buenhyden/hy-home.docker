{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.invalid/schemas/document-profile.schema.json",
  "title": "Stage 99 document registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profiles",
    "template_roles",
    "lifecycles",
    "identity_spaces",
    "transitions",
    "common",
    "indexes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_statuses": {
          "$ref": "#/$defs/stringList"
        },
        "archive_retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disposition_entry_statuses"
          ],
          "properties": {
            "disposition_entry_statuses": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/dispositionStatusList"
              }
            }
          }
        },
        "link_types": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normative",
            "evidence",
            "historical",
            "navigation"
          ],
          "properties": {
            "normative": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "direction",
                "required",
                "authority",
                "pinned_version",
                "on_target_removal"
              ],
              "properties": {
                "direction": {
                  "const": "forward"
                },
                "required": {
                  "const": true
                },
                "authority": {
                  "const": "binding"
                },
                "pinned_version": {
                  "const": "current"
                },
                "on_target_removal": {
                  "const": "update-consumer"
                }
              }
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "direction",
                "required",
                "authority",
                "pinned_version",
                "on_target_removal"
              ],
              "properties": {
                "direction": {
                  "const": "forward"
                },
                "required": {
                  "const": true
                },
                "authority": {
                  "const": "none"
                },
                "pinned_version": {
                  "const": "revision"
                },
                "on_target_removal": {
                  "const": "keep-pinned"
                }
              }
            },
            "historical": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "direction",
                "required",
                "authority",
                "pinned_version",
                "on_target_removal"
              ],
              "properties": {
                "direction": {
                  "const": "forward"
                },
                "required": {
                  "const": false
                },
                "authority": {
                  "const": "none"
                },
                "pinned_version": {
                  "const": "revision"
                },
                "on_target_removal": {
                  "const": "plain-text"
                }
              }
            },
            "navigation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "direction",
                "required",
                "authority",
                "pinned_version",
                "on_target_removal"
              ],
              "properties": {
                "direction": {
                  "const": "forward"
                },
                "required": {
                  "const": true
                },
                "authority": {
                  "const": "none"
                },
                "pinned_version": {
                  "const": "current"
                },
                "on_target_removal": {
                  "const": "update-consumer"
                }
              }
            }
          }
        },
        "link_profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "markdown",
            "vault-wiki"
          ],
          "properties": {
            "markdown": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "syntax",
                "link_types"
              ],
              "properties": {
                "syntax": {
                  "const": "relative-markdown"
                },
                "link_types": {
                  "const": true
                }
              }
            },
            "vault-wiki": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "syntax",
                "link_types"
              ],
              "properties": {
                "syntax": {
                  "const": "wiki"
                },
                "link_types": {
                  "const": false
                }
              }
            }
          }
        },
        "common_form_contract": {
          "$comment": "The adopted common section form revision (id and version). Optional so a Registry from before the pin still validates; template_definition reads it for every role that declares required_subsections.",
          "type": "string",
          "pattern": "^COMMON-DOC-FORM-[0-9]+/(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?!\\n)"
        },
        "vocabulary_contract": {
          "$comment": "The adopted shared vocabulary contract: identity, SemVer version, the source package label and hash it was first adopted from, and Term ID to Term pairs only; the glossary owns meaning.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_id",
            "version",
            "source_label",
            "source_sha256",
            "glossary_path",
            "terms"
          ],
          "properties": {
            "contract_id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?!\\n)"
            },
            "source_label": {
              "type": "string",
              "minLength": 1
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?!\\n)"
            },
            "glossary_path": {
              "type": "string",
              "minLength": 1
            },
            "terms": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "term_id",
                  "term"
                ],
                "properties": {
                  "term_id": {
                    "type": "string",
                    "pattern": "^TERM-[A-Z][A-Z0-9-]*$"
                  },
                  "term": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "document_relations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "structural_ownership",
            "constraint",
            "traceability",
            "promotion",
            "supersession",
            "change_impact"
          ],
          "properties": {
            "authority": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "direction",
                "writers",
                "owner",
                "reverse_lookup"
              ],
              "properties": {
                "id": {
                  "const": "rel.authority"
                },
                "direction": {
                  "const": "consumer-to-owner"
                },
                "writers": {
                  "$ref": "#/$defs/relationWriters"
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "reverse_lookup": {
                  "const": "derived"
                }
              }
            },
            "structural_ownership": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "direction",
                "writers",
                "owner",
                "reverse_lookup"
              ],
              "properties": {
                "id": {
                  "const": "rel.structural-ownership"
                },
                "direction": {
                  "const": "child-to-parent"
                },
                "writers": {
                  "$ref": "#/$defs/relationWriters"
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "reverse_lookup": {
                  "const": "derived"
                }
              }
            },
            "constraint": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "direction",
                "writers",
                "owner",
                "reverse_lookup"
              ],
              "properties": {
                "id": {
                  "const": "rel.constraint"
                },
                "direction": {
                  "const": "change-to-constraint"
                },
                "writers": {
                  "$ref": "#/$defs/relationWriters"
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "reverse_lookup": {
                  "const": "derived"
                }
              }
            },
            "traceability": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "direction",
                "writers",
                "owner",
                "reverse_lookup"
              ],
              "properties": {
                "id": {
                  "const": "rel.traceability"
                },
                "direction": {
                  "const": "record-to-source"
                },
                "writers": {
                  "$ref": "#/$defs/relationWriters"
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "reverse_lookup": {
                  "const": "derived"
                }
              }
            },
            "promotion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "direction",
                "writers",
                "owner",
                "reverse_lookup"
              ],
              "properties": {
                "id": {
                  "const": "rel.promotion"
                },
                "direction": {
                  "const": "plan-to-target-owner"
                },
                "writers": {
                  "$ref": "#/$defs/relationWriters"
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "reverse_lookup": {
                  "const": "derived"
                }
              }
            },
            "supersession": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "direction",
                "writers",
                "owner",
                "reverse_lookup",
                "retained_reverse_fields"
              ],
              "properties": {
                "id": {
                  "const": "rel.supersession"
                },
                "direction": {
                  "const": "successor-to-predecessor"
                },
                "writers": {
                  "$ref": "#/$defs/relationWriters"
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "reverse_lookup": {
                  "const": "derived"
                },
                "retained_reverse_fields": {
                  "$ref": "#/$defs/stringList"
                }
              }
            },
            "change_impact": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "direction",
                "writers",
                "owner",
                "reverse_lookup"
              ],
              "properties": {
                "id": {
                  "const": "rel.change-impact"
                },
                "direction": {
                  "const": "owner-to-consumer"
                },
                "writers": {
                  "$ref": "#/$defs/relationWriters"
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "reverse_lookup": {
                  "const": "derived"
                }
              }
            }
          }
        },
        "incident_closure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "incident_status",
            "postmortem_status",
            "corrective_section"
          ],
          "properties": {
            "incident_status": {
              "type": "string",
              "minLength": 1
            },
            "postmortem_status": {
              "type": "string",
              "minLength": 1
            },
            "corrective_section": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "section_forms": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "section"
            ],
            "properties": {
              "profile": {
                "type": "string",
                "minLength": 1
              },
              "section": {
                "type": "string",
                "minLength": 1
              },
              "subsection": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "frontmatter_order": {
          "$ref": "#/$defs/stringList"
        },
        "frozen_transition_fields": {
          "$ref": "#/$defs/stringList"
        },
        "generated_outputs": {
          "$ref": "#/$defs/stringMap"
        },
        "globally_forbidden": {
          "$ref": "#/$defs/stringList"
        },
        "inventory_excludes": {
          "$ref": "#/$defs/stringList"
        },
        "root_exceptions": {
          "$ref": "#/$defs/stringMap"
        },
        "template_placeholders": {
          "$ref": "#/$defs/stringMap"
        },
        "template_required_placeholders": {
          "$ref": "#/$defs/stringList"
        },
        "terminal_statuses": {
          "$ref": "#/$defs/stringList"
        },
        "transitions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stringList"
          }
        },
        "typed_keys": {
          "$ref": "#/$defs/stringList"
        },
        "contract_id": {
          "enum": [
            "SDLC-COMMON-v4",
            "SDLC-COMMON-v5",
            "SDLC-COMMON-r10-local-v1"
          ]
        },
        "result_domain": {
          "oneOf": [
            {
              "const": [
                "NOT_RUN",
                "PASS",
                "FAIL",
                "DEFER",
                "NOT_APPLICABLE"
              ]
            },
            {
              "const": [
                "PASS",
                "FAIL",
                "ERROR",
                "NOT_RUN",
                "CANCELLED",
                "NOT_APPLICABLE"
              ]
            }
          ]
        },
        "acceptance_domain": {
          "const": [
            "pending",
            "accepted",
            "rejected",
            "not-required"
          ]
        },
        "evidence_columns": {
          "oneOf": [
            {
              "const": [
                "Evidence",
                "Criteria",
                "Work Unit",
                "Check",
                "Input",
                "Result",
                "Location",
                "Resolves"
              ]
            },
            {
              "const": [
                "Evidence",
                "Criteria",
                "Work Unit",
                "Check",
                "Input",
                "Result",
                "Location",
                "Required",
                "Resolves"
              ]
            }
          ]
        },
        "plan_columns": {
          "const": [
            "Work Unit",
            "Criteria",
            "Work",
            "Dependencies",
            "Task",
            "Verification"
          ]
        },
        "spec_section": {
          "const": "Acceptance Criteria"
        },
        "plan_section": {
          "const": "Work Breakdown"
        },
        "task_section": {
          "const": "Evidence"
        },
        "criterion_acceptance_section": {
          "const": "Criterion Acceptance"
        },
        "criterion_acceptance_columns": {
          "oneOf": [
            {
              "const": [
                "Criterion",
                "Acceptance",
                "Evidence",
                "Decision"
              ]
            },
            {
              "const": [
                "Criterion",
                "Acceptance",
                "Evidence",
                "Decision",
                "Current Owner"
              ]
            }
          ]
        },
        "execution_items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "section",
            "subsection",
            "table_headers",
            "minimum_rows"
          ],
          "properties": {
            "section": {
              "const": "Work Log"
            },
            "subsection": {
              "const": "Execution Items"
            },
            "table_headers": {
              "const": [
                "Item",
                "Work Unit",
                "Scope",
                "Owner",
                "Status",
                "Blocker"
              ]
            },
            "minimum_rows": {
              "const": 2
            }
          }
        },
        "readme_documents_columns": {
          "const": [
            "Path",
            "Purpose"
          ]
        },
        "readme_documents_optional_columns": {
          "const": [
            "Owner"
          ]
        },
        "template_initial_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?!\\n)"
        },
        "lifecycle_generation": {
          "type": "integer",
          "minimum": 1
        },
        "spec_completion_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spec_section",
            "plan_section",
            "task_section",
            "table_headers"
          ],
          "properties": {
            "spec_section": {
              "type": "string",
              "minLength": 1
            },
            "plan_section": {
              "type": "string",
              "minLength": 1
            },
            "task_section": {
              "type": "string",
              "minLength": 1
            },
            "table_headers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true
            },
            "item_table_headers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true
            },
            "task_result_values": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true
            }
          },
          "description": "Historical generation 1–4 reader contract only; forbidden in generation 5 and later Registries."
        },
        "task_lifecycle_events": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "section",
            "subsection",
            "table_headers",
            "reconciliation"
          ],
          "properties": {
            "section": {
              "type": "string",
              "minLength": 1
            },
            "subsection": {
              "type": "string",
              "minLength": 1
            },
            "table_headers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true
            },
            "reconciliation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subsection",
                "table_headers",
                "disposition"
              ],
              "properties": {
                "subsection": {
                  "type": "string",
                  "minLength": 1
                },
                "table_headers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 10,
                  "maxItems": 10,
                  "uniqueItems": true
                },
                "disposition": {
                  "const": "concurrent-duplicate-observation"
                }
              }
            },
            "migration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subsection",
                "table_headers"
              ],
              "properties": {
                "subsection": {
                  "type": "string",
                  "minLength": 1
                },
                "table_headers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "uniqueItems": true
                },
                "normalizations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "lifecycle_id",
                      "from_status",
                      "to_status"
                    ],
                    "properties": {
                      "lifecycle_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "from_status": {
                        "type": "string",
                        "minLength": 1
                      },
                      "to_status": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            }
          }
        },
        "review_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "section",
            "table_headers",
            "acceptance_values"
          ],
          "properties": {
            "section": {
              "type": "string",
              "minLength": 1
            },
            "table_headers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true
            },
            "acceptance_values": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true
            }
          },
          "description": "Historical generation 1–4 reader contract only; forbidden in generation 5 and later Registries."
        },
        "frontmatter_key_definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "meaning",
              "writer",
              "consumers"
            ],
            "properties": {
              "meaning": {
                "type": "string",
                "minLength": 1
              },
              "writer": {
                "type": "string",
                "minLength": 1
              },
              "consumers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "table_column_definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "meaning",
              "data_type"
            ],
            "properties": {
              "meaning": {
                "type": "string",
                "minLength": 1
              },
              "data_type": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "profile_exception_definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner",
              "delta",
              "validation",
              "expiry_or_review"
            ],
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "delta": {
                "type": "string",
                "minLength": 1
              },
              "validation": {
                "type": "string",
                "minLength": 1
              },
              "expiry_or_review": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "section_prohibited_content": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "frozen_transition_fields",
        "template_initial_version"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle_generation": {
                "minimum": 5
              }
            },
            "required": [
              "lifecycle_generation"
            ]
          },
          "then": {
            "required": [
              "contract_id",
              "result_domain",
              "acceptance_domain",
              "evidence_columns",
              "plan_columns",
              "spec_section",
              "plan_section",
              "task_section",
              "readme_documents_columns",
              "readme_documents_optional_columns"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "spec_completion_evidence"
                  ]
                },
                {
                  "required": [
                    "review_evidence"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "spec_completion_evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "lifecycle_generation": {
                "minimum": 6
              }
            },
            "required": [
              "lifecycle_generation"
            ]
          },
          "then": {
            "required": [
              "criterion_acceptance_section",
              "criterion_acceptance_columns",
              "execution_items"
            ]
          }
        }
      ]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "template_roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/templateRole"
      }
    },
    "lifecycles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/lifecycle"
      }
    },
    "identity_spaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/identitySpace"
      }
    },
    "transitions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "indexes": {
      "description": "Index document path -> the profile whose documents it must enumerate.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "profileException": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "year-directory"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "owner"
          ],
          "properties": {
            "kind": {
              "enum": [
                "delegate-reference-members",
                "provider-owned-binding",
                "native-skill-envelope"
              ]
            },
            "owner": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dispositionStatusList": {
      "$comment": "Lists only statuses the profile's lifecycle can reach; an incident or postmortem lifecycle lists none. registry.py enforces both where this definition is declared.",
      "$ref": "#/$defs/stringList"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "frontmatter_policy",
        "path_pattern",
        "type",
        "artifact_id_pattern",
        "identity_relation",
        "template_id",
        "required_frontmatter",
        "optional_frontmatter",
        "required_sections",
        "optional_sections",
        "lifecycle_id",
        "traceability",
        "exceptions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "frontmatter_policy": {
          "enum": [
            "required",
            "absent",
            "unmanaged"
          ]
        },
        "path_pattern": {
          "type": "string",
          "minLength": 1
        },
        "additional_paths": {
          "$ref": "#/$defs/stringList"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
        },
        "language": {
          "enum": [
            "ko",
            "en"
          ]
        },
        "artifact_id_pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_relation": {
          "enum": [
            "direct",
            "package-member",
            "inherited",
            "none"
          ]
        },
        "template_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_frontmatter": {
          "$ref": "#/$defs/stringList"
        },
        "optional_frontmatter": {
          "$ref": "#/$defs/stringList"
        },
        "required_sections": {
          "$ref": "#/$defs/stringList"
        },
        "optional_sections": {
          "$ref": "#/$defs/stringList"
        },
        "required_subsections": {
          "$ref": "#/$defs/subsectionMap"
        },
        "optional_subsections": {
          "$ref": "#/$defs/subsectionMap"
        },
        "free_form_sections": {
          "type": "boolean"
        },
        "ordered_sections": {
          "type": "boolean"
        },
        "nonempty_sections": {
          "type": "boolean"
        },
        "lifecycle_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "traceability": {
          "$ref": "#/$defs/traceability"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profileException"
          }
        },
        "frontmatter_values": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "frontmatter_routes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required_frontmatter_by_status": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/stringList"
          }
        },
        "additional_path_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_parent_profiles": {
          "$ref": "#/$defs/stringList"
        },
        "internal_id_spaces": {
          "$ref": "#/$defs/stringList"
        },
        "parent_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "templateRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "profiles",
        "purpose",
        "responsibility",
        "non_goals",
        "policy_refs",
        "vocabulary_refs",
        "applicability",
        "relationships",
        "consumer_paths",
        "validation",
        "migration"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^docs/99\\.templates/templates/"
        },
        "profiles": {
          "$ref": "#/$defs/stringList",
          "minItems": 1,
          "maxItems": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "responsibility": {
          "type": "string",
          "minLength": 1
        },
        "non_goals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vocabulary_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "relationships": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consumer_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "positive",
            "negative",
            "regression"
          ],
          "properties": {
            "positive": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "negative": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "regression": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "meaning_map",
            "retained_history",
            "rollback"
          ],
          "properties": {
            "meaning_map": {
              "type": "string",
              "minLength": 1
            },
            "retained_history": {
              "type": "string",
              "minLength": 1
            },
            "rollback": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "conditional_units": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_status",
        "terminal_statuses",
        "statuses",
        "transitions"
      ],
      "properties": {
        "initial_status": {
          "type": "string",
          "minLength": 1
        },
        "terminal_statuses": {
          "$ref": "#/$defs/stringList"
        },
        "statuses": {
          "$ref": "#/$defs/stringList"
        },
        "transitions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stringList"
          }
        }
      }
    },
    "identitySpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix",
        "width",
        "high_water",
        "next_number",
        "child_spaces"
      ],
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "high_water": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "next_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "current_issued": {
          "type": "array",
          "maxItems": 9999,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "uniqueItems": true
        },
        "reserved_history": {
          "description": "Terminal reservations; allocation candidates must be compared with one captured Git index blob snapshot or one resolved commit OID predecessor and may not reclassify these numbers or regress the package high-water.",
          "type": "array",
          "maxItems": 9999,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "uniqueItems": true
        },
        "child_spaces": {
          "type": "object",
          "maxProperties": 9999,
          "additionalProperties": {
            "$ref": "#/$defs/identitySpace"
          }
        }
      }
    },
    "subsectionMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/stringList"
      },
      "minProperties": 1
    },
    "relationWriters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "frontmatter",
              "link",
              "section",
              "derived"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
