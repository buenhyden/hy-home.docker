{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hy-home.invalid/schemas/document-profile.schema.json",
  "title": "Stage 99 document registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profiles",
    "template_roles",
    "lifecycles",
    "identity_spaces",
    "transitions",
    "common",
    "indexes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_statuses": { "$ref": "#/$defs/stringList" },
        "archive_disposition_model": { "enum": ["transition", "adopted"] },
        "archive_retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "standard_version",
            "catalog_path",
            "capture_section",
            "capture_columns",
            "assessment_section",
            "assessment_columns",
            "assessment_values",
            "availability_values",
            "default_assessment",
            "default_availability",
            "absence_token",
            "legacy_capture_revision",
            "citation_order",
            "blocked_assessments",
            "history_only_availability",
            "legacy_transition_units",
            "disposition_entry_statuses"
          ],
          "properties": {
            "standard_version": {
              "const": "3.0.0"
            },
            "catalog_path": {
              "const": "docs/98.archive/retention-catalog.md"
            },
            "capture_section": {
              "type": "string",
              "minLength": 1
            },
            "capture_columns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true
            },
            "assessment_section": {
              "type": "string",
              "minLength": 1
            },
            "assessment_columns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 8,
              "maxItems": 8,
              "uniqueItems": true
            },
            "assessment_values": {
              "const": [
                "unreviewed",
                "usable",
                "superseded",
                "withdrawn",
                "invalidated"
              ]
            },
            "availability_values": {
              "const": [
                "retained",
                "git-history-only"
              ]
            },
            "default_assessment": {
              "const": "unreviewed"
            },
            "default_availability": {
              "const": "retained"
            },
            "absence_token": {
              "const": "none"
            },
            "legacy_capture_revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "citation_order": {
              "const": [
                "resolve",
                "assessment",
                "route-record",
                "profile",
                "context",
                "integrity"
              ]
            },
            "blocked_assessments": {
              "const": [
                "withdrawn",
                "invalidated"
              ]
            },
            "legacy_transition_units": {
              "const": [
                "superseded/02.architecture/decisions/0036-archive-occupancy-citation-and-frozen-identity.md"
              ]
            },
            "disposition_entry_statuses": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/stringList"
              }
            },
            "history_only_availability": {
              "const": "git-history-only"
            }
          }
        },
        "incident_closure": {"type":"object","additionalProperties":false,"required":["incident_status","postmortem_status","corrective_section"],"properties":{"incident_status":{"type":"string","minLength":1},"postmortem_status":{"type":"string","minLength":1},"corrective_section":{"type":"string","minLength":1}}},
        "archive_source_prefixes": { "$ref": "#/$defs/stringList" },
        "frontmatter_order": { "$ref": "#/$defs/stringList" },
        "frozen_transition_fields": { "$ref": "#/$defs/stringList" },
        "generated_outputs": { "$ref": "#/$defs/stringMap" },
        "globally_forbidden": { "$ref": "#/$defs/stringList" },
        "inventory_excludes": { "$ref": "#/$defs/stringList" },
        "root_exceptions": { "$ref": "#/$defs/stringMap" },
        "template_placeholders": { "$ref": "#/$defs/stringMap" },
        "template_required_placeholders": { "$ref": "#/$defs/stringList" },
        "terminal_statuses": { "$ref": "#/$defs/stringList" },
        "transitions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/stringList" }
        },
        "typed_keys": { "$ref": "#/$defs/stringList" },
        "template_initial_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "spec_completion_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spec_section",
            "plan_section",
            "task_section",
            "table_headers"
          ],
          "properties": {
            "spec_section": {
              "type": "string",
              "minLength": 1
            },
            "plan_section": {
              "type": "string",
              "minLength": 1
            },
            "task_section": {
              "type": "string",
              "minLength": 1
            },
            "table_headers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true
            }
          }
        }
      },
      "required": [
        "archive_disposition_model",
        "frozen_transition_fields",
        "template_initial_version",
        "spec_completion_evidence"
      ]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "template_roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/templateRole"
      }
    },
    "lifecycles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/lifecycle"
      }
    },
    "identity_spaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/identitySpace"
      }
    },
    "transitions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "indexes": {
      "description": "Index document path -> the profile whose documents it must enumerate.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "profileException": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "year-directory" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "owner"],
          "properties": {
            "kind": {
              "enum": ["delegate-reference-members", "provider-owned-binding", "native-skill-envelope"]
            },
            "owner": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "status", "paths"],
          "properties": {
            "kind": { "const": "frozen-legacy-status" },
            "status": { "type": "string", "minLength": 1 },
            "paths": {
              "$ref": "#/$defs/stringList",
              "minItems": 1
            }
          }
        }
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "frontmatter_policy",
        "path_pattern",
        "type",
        "artifact_id_pattern",
        "identity_relation",
        "template_id",
        "required_frontmatter",
        "optional_frontmatter",
        "required_sections",
        "optional_sections",
        "lifecycle_id",
        "traceability",
        "exceptions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "frontmatter_policy": {
          "enum": [
            "required",
            "absent",
            "unmanaged"
          ]
        },
        "path_pattern": {
          "type": "string",
          "minLength": 1
        },
        "additional_paths": {
          "$ref": "#/$defs/stringList"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
        },
        "language": {
          "enum": [
            "ko",
            "en"
          ]
        },
        "artifact_id_pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_relation": {
          "enum": [
            "direct",
            "package-member",
            "inherited",
            "none"
          ]
        },
        "template_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_frontmatter": {
          "$ref": "#/$defs/stringList"
        },
        "optional_frontmatter": {
          "$ref": "#/$defs/stringList"
        },
        "required_sections": {
          "$ref": "#/$defs/stringList"
        },
        "optional_sections": {
          "$ref": "#/$defs/stringList"
        },
        "free_form_sections": {
          "type": "boolean"
        },
        "sealed_section_shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stringList"
          }
        },
        "lifecycle_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "traceability": {
          "$ref": "#/$defs/traceability"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profileException"
          }
        },
        "frontmatter_values": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "frontmatter_routes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required_frontmatter_by_status": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/stringList"
          }
        }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_parent_profiles": {
          "$ref": "#/$defs/stringList"
        },
        "internal_id_spaces": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "templateRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "profiles"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^docs/99\\.templates/templates/"
        },
        "profiles": {
          "$ref": "#/$defs/stringList",
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_status",
        "terminal_statuses",
        "statuses",
        "transitions"
      ],
      "properties": {
        "initial_status": {
          "type": "string",
          "minLength": 1
        },
        "terminal_statuses": {
          "$ref": "#/$defs/stringList"
        },
        "statuses": {
          "$ref": "#/$defs/stringList"
        },
        "transitions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stringList"
          }
        }
      }
    },
    "identitySpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix",
        "width",
        "high_water",
        "next_number",
        "child_spaces"
      ],
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "high_water": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "next_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "current_issued": {
          "type": "array",
          "maxItems": 9999,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "uniqueItems": true
        },
        "reserved_history": {
          "description": "Terminal reservations; allocation candidates must be compared with one captured Git index blob snapshot or one resolved commit OID predecessor and may not reclassify these numbers or regress the package high-water.",
          "type": "array",
          "maxItems": 9999,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "uniqueItems": true
        },
        "child_spaces": {
          "type": "object",
          "maxProperties": 9999,
          "additionalProperties": {
            "$ref": "#/$defs/identitySpace"
          }
        }
      }
    }
  }
}
