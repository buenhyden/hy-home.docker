* text=auto eol=lf

# Common text formats
*.md text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
Makefile text eol=lf

# Common binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
*.pdf binary

# Unified diff context uses a marker space before upstream Go tabs/blank lines.
infra/06-observability/gatus/patches/oidc-hardening.patch whitespace=-blank-at-eol,-space-before-tab
