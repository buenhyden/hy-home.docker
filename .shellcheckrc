# Shared shellcheck defaults for local runs and pre-commit.
#
# `severity` is a command-line flag, not an rc directive: shellcheck silently
# ignores unknown keys here, so a `severity=warning` line looked like a second
# owner while changing nothing. Severity is owned solely by the `shellcheck`
# hook arguments in `.pre-commit-config.yaml`.

external-sources=true
source-path=SCRIPTDIR
